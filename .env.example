UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_ACCESS_TOKEN=

# Optional: comma-separated NSE symbols. Empty = all NSE_EQ instruments from Upstox master.
NSE_SYMBOLS=

# Optional Upstash cache for Vercel/serverless. Leave empty to use in-memory cache only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional scanner tuning
SCAN_BATCH_SIZE=8
SCAN_BATCH_DELAY_MS=250
INSTRUMENT_CACHE_TTL_SECONDS=86400
